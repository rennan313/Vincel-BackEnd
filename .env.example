DATABASE_URL="mongodb://localhost:27017/VincelApiDb?directConnection=true"
PORT=3333

JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRES_IN="15m"
# How long a refresh token stays valid before the user must log in again.
# The access token above keeps expiring every 15m regardless — the refresh
# token is what lets the front renew it silently in the background.
REFRESH_TOKEN_TTL_DAYS=30

FRONTEND_URL="http://localhost:5173"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3333/auth/google/callback"

ENABLED_ACQUIRERS="mercado-pago"
MERCADOPAGO_ACCESS_TOKEN="replace-with-mercadopago-access-token"
MERCADOPAGO_WEBHOOK_SECRET="replace-with-mercadopago-webhook-secret"
MERCADOPAGO_BACK_URL="http://localhost:5173/billing"

# Free trial length for a brand-new company (no acquirer involved yet).
# 90 in dev so it never expires mid-testing; set to 30 in production.
SIGNUP_TRIAL_DAYS=90

# Google Cloud Storage bucket for project documents (plantas, contratos,
# imagens, ...). Auth is via Application Default Credentials — the Cloud
# Run service's own service account in production, or `gcloud auth
# application-default login` locally. No key file needed.
GCS_DOCUMENTS_BUCKET="replace-with-gcs-bucket-name"
