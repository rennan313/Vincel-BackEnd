generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VINCEL_ADMIN
  ADMIN
  ARCHITECT
  FINANCE
  CUSTOMER
}

enum CompanyDocumentType {
  CNPJ
  CPF
}

// A "company" is a tenant (escritório). Every tenant-owned record carries a
// companyId; shared reference data (project types, services, materials...)
// does not and stays global across tenants.
model Company {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  document     String              @unique
  documentType CompanyDocumentType
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  users   User[]
  clients Client[]
}

enum ClientType {
  PF
  PJ
}

type ClientAddress {
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
}

model Client {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  type      ClientType
  document  String?
  address   ClientAddress?
  active    Boolean        @default(true)
  companyId String         @db.ObjectId
  company   Company        @relation(fields: [companyId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  // Absent for accounts created via an OAuth provider (e.g. Google).
  passwordHash String?
  // Set for accounts created/linked via Google OAuth. Not @unique here:
  // MongoDB's unique index isn't sparse for Prisma-written nulls, so two
  // password-based users (both with no googleId) would collide. Uniqueness
  // is enforced at the application layer once the Google OAuth flow exists.
  googleId     String?
  role         UserRole
  active       Boolean   @default(true)
  // Required for every role except VINCEL_ADMIN, enforced at the application layer.
  companyId    String?   @db.ObjectId
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}
