generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VINCEL_ADMIN
  ADMIN
  ARCHITECT
  FINANCE
  CUSTOMER
}

enum CompanyDocumentType {
  CNPJ
  CPF
}

type CompanyAddress {
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
}

// A "company" is a tenant (escritório). Every tenant-owned record carries a
// companyId; shared reference data (project types, services, materials...)
// does not and stays global across tenants.
model Company {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  document     String              @unique
  documentType CompanyDocumentType
  // Editable via PATCH /companies/me (ADMIN) — logoUrl/contactEmail/
  // contactPhone are also shown on the public client-invite page (GET
  // /companies/:id/public), address is not.
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      CompanyAddress?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  users                    User[]
  clients                  Client[]
  projects                 Project[]
  providers                Provider[]
  subscriptions            Subscription[]
  agendaTasks              AgendaTask[]
  timeEntries              TimeEntry[]
  scheduleStatusCategories ScheduleStatusCategory[]
  briefingQuestions        BriefingQuestion[]
}

// User-defined categories for the Cronograma's schedule-adherence
// indicator (e.g. "No prazo"/verde, "Atenção"/amarelo, "Atrasado"/vermelho)
// — the escritório picks the label, color and the delay threshold, not the
// product. Resolution: sort ascending by thresholdDays, take the LAST
// category whose thresholdDays <= a project's computed delay (días de
// atraso do término previsto até hoje), falling back to the smallest
// threshold when the project isn't late at all (or is ahead). A project
// may instead pin an explicit category (Project.scheduleStatusCategoryId),
// which always wins over this automatic resolution — done entirely on the
// frontend, this table only holds the category definitions themselves.
model ScheduleStatusCategory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  label         String
  // Hex color, e.g. "#22c55e".
  color         String
  thresholdDays Int
  companyId     String   @db.ObjectId
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

enum ClientType {
  PF
  PJ
}

type ClientAddress {
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
}

model Client {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  type      ClientType
  document  String?
  address   ClientAddress?
  // Hashed (bcryptjs), set by an ADMIN via PATCH /clients/:id — null means
  // this client has no portal login yet. No @unique here (email itself
  // isn't unique across Clients — see ClientsService), so the client-auth
  // login lookup enforces "email unique among password-bearing clients"
  // at the application level instead.
  password  String?
  active    Boolean        @default(true)
  companyId String         @db.ObjectId
  company   Company        @relation(fields: [companyId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@index([companyId])
}

enum ProjectStatus {
  in_progress
  completed
  paused
  canceled
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
}

// A single checklist-style item on a PlanningPhase's task board — the
// etapa is the "card" (Cronograma tab, Jira-like), this is one of its
// tasks. id/createdAt are generated client-side, same as PlanningPhase's
// own key — there's no dedicated endpoint for these, they ride along with
// the phase inside the same PATCH /projects/:id { planningPhases }.
type PhaseTask {
  id          String
  title       String
  description String?
  done        Boolean  @default(false)
  createdAt   DateTime
}

type PlanningPhase {
  key           String
  name          String
  estimatedDays Int
  // When this task is scheduled to start — independent of the project's
  // overall startDate/endDate.
  startDate     DateTime?
  // Término previsto — defaults to startDate + estimatedDays (computed on
  // the front) but the user can override it here; the front compares this
  // against the computed estimate to show how many days ahead/behind.
  endDate       DateTime?
  // Free-text: which team/person executes this task.
  team          String?
  // How many hours this task is expected to take — relevant for projects
  // billed per_hour (see Project.feeModel), but tracked on every phase.
  estimatedHours Float?
  // Hours already worked on this task. Manually edited for now; a future
  // sidebar timer will be able to add to this automatically instead.
  loggedHours    Float?
  // This etapa's own task board (Cronograma tab) — a Jira-card-style
  // checklist, shown in an accordion per etapa.
  tasks          PhaseTask[]
}

// How honorários is calculated — per_sqm (rate × área) or per_hour (rate × estimatedHours).
enum FeeModel {
  per_sqm
  per_hour
}

enum PaymentMethod {
  cash
  installments
  by_phase
  monthly
  custom
}

type ProjectInstallment {
  id     String
  label  String
  amount Float
}

type ProjectAddress {
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
}

// Fixed set of common AEC service-provider roles — OUTRO is the escape
// hatch for anything not on the list, paired with ProjectTeamMember.customRole.
enum ProviderRole {
  ARQUITETO_COLABORADOR
  ENGENHEIRO_ESTRUTURAL
  ENGENHEIRO_ELETRICO
  ENGENHEIRO_HIDRAULICO
  MESTRE_OBRAS
  EMPREITEIRO
  PEDREIRO
  ELETRICISTA
  ENCANADOR
  MARCENEIRO
  SERRALHEIRO
  VIDRACEIRO
  PINTOR
  GESSEIRO
  PAISAGISTA
  DECORADOR
  OUTRO
}

// Where a provider stands in the hiring/work lifecycle for this project.
enum ProviderStatus {
  A_CONTRATAR
  CONTRATADO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

// A service provider (prestador de serviço) — a company-wide contact the
// office reuses across projects, not a one-off snapshot. Not a User
// account; providers never log in, they're just tracked contacts.
model Provider {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  // A provider can hold more than one participação (e.g. eletricista and
  // encanador) — always at least one.
  role       ProviderRole[]
  // Only meaningful when role includes OUTRO.
  customRole  String?
  phone       String?
  email       String?
  // Razão social — named to avoid clashing with the `company` tenant relation below.
  companyName String?
  document    String?
  // Status only makes sense per-project — see ProjectProvider.status.
  active      Boolean      @default(true)
  companyId   String       @db.ObjectId
  company     Company      @relation(fields: [companyId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  projectLinks ProjectProvider[]

  @@index([companyId])
}

// Join record — a provider's participation on one specific project. Kept
// separate from Provider itself because status/responsibility only make
// sense per-project; the same provider can have a different status on
// each project they're linked to.
model ProjectProvider {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  projectId      String         @db.ObjectId
  project        Project        @relation(fields: [projectId], references: [id])
  providerId     String         @db.ObjectId
  provider       Provider       @relation(fields: [providerId], references: [id])
  // Free-text description of what this provider is responsible for on
  // THIS project — distinct from Provider.role, which is their general trade.
  responsibility String?
  status         ProviderStatus @default(A_CONTRATAR)
  // Valor combinado com este prestador para este projeto — cobre um pacote
  // fechado/empreitada; não é um controle de parcelas/pagamentos.
  agreedAmount   Float?
  // Peso (%) que a tarefa deste prestador representa na entrega do
  // projeto — 0 a 100. Não é validado para somar 100% entre prestadores.
  weight         Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([projectId, providerId])
  @@index([projectId])
  @@index([providerId])
}

model Project {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       String
  // Free-text description, only meaningful when type is the "outro" catalog entry.
  customType String?
  areaSqm    Float?
  status     ProjectStatus @default(in_progress)

  // Set when linked to a Client record; the name is always denormalized
  // here so search/listing works even for a free-typed (unlinked) client.
  clientId   String? @db.ObjectId
  client     Client? @relation(fields: [clientId], references: [id])
  clientName String

  services           String[]
  customServiceLabel String?

  planningPhases PlanningPhase[]
  complexity     Complexity?

  constructionBudget Float?
  feeModel           FeeModel?
  feeRate            Float?
  // Only meaningful when feeModel is per_hour.
  estimatedHours     Float?
  // Derived on the front from feeRate × área (per_sqm) or feeRate × estimatedHours (per_hour).
  feeAmount          Float?
  paymentMethod      PaymentMethod?
  installments       ProjectInstallment[]

  providerLinks ProjectProvider[]
  materials     ProjectMaterial[]
  expenses      ProjectExpense[]
  documents     ProjectDocument[]
  timeEntries   TimeEntry[]
  briefing      ProjectBriefing?

  startDate DateTime?
  endDate   DateTime?

  // Manual pin onto a ScheduleStatusCategory — overrides the frontend's
  // automatic (delay-based) resolution when set. No @relation: categories
  // are looked up by id from the same company's list, not joined here.
  scheduleStatusCategoryId String? @db.ObjectId

  address ProjectAddress?

  active    Boolean   @default(true)
  companyId String    @db.ObjectId
  company   Company   @relation(fields: [companyId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

// A material's specification lifecycle on a project — A_DEFINIR (not yet
// chosen) -> ESPECIFICADO -> APROVADO -> COMPRADO.
enum ProjectMaterialStatus {
  A_DEFINIR
  ESPECIFICADO
  APROVADO
  COMPRADO
}

// A material specified for one project — room, status, quantity/cost and
// the spec sheet ("ficha") shown in its detail view. Optionally linked to a
// Product from the catalog (for provenance/reuse), but always a full
// snapshot of its own — editing this never mutates the catalog Product.
model ProjectMaterial {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])
  // Set when cadastrado a partir do catálogo de produtos; null for a
  // free-typed material with no catalog entry.
  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  name     String
  category String?
  // "Ambiente" — which room/space this material is specified for (e.g. "Suíte", "Cozinha").
  room     String?
  status   ProjectMaterialStatus @default(A_DEFINIR)

  quantity  Float?
  unit      String?
  unitCost  Float?
  // Derived on the front from unitCost × quantity, but stored since it's
  // shown directly and can outlive an edit to either factor.
  totalCost Float?
  // Free text for now — not a reusable Supplier-like record.
  supplier  String?

  brand     String?
  model     String?
  thickness String?
  dimension String?
  finish    String?
  color     String?

  image        String?
  referenceUrl String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([productId])
}

// A free-form cost the project incurs that isn't a material's totalCost or
// a prestador's agreedAmount — taxas, licenças, transporte, imprevistos.
model ProjectExpense {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// A file (planta, memorial, contrato, imagem, ...) attached to a project.
// The bytes live in Google Cloud Storage under storageKey — this row is
// just the metadata + pointer, never the file content itself.
model ProjectDocument {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  project    Project  @relation(fields: [projectId], references: [id])
  name       String
  type       String
  notes      String?
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
}

enum BriefingQuestionType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  LINKS
  // Client uploads photos of existing items/furniture they want to keep
  // or reuse — stored the same way as LINKS (BriefingAnswer.values), just
  // populated by POST .../briefing/public/photos instead of typed in.
  PHOTOS
}

// The office's own customizable briefing form — a flat, ordered list per
// company, edited from Configurações (see companies.controller's
// briefing-questions routes) and reused for every project. Seeded with a
// default set the first time a company's list is fetched empty (see
// BriefingQuestionsService.listForCompany) rather than at company
// creation, so existing companies pick up the same defaults on first use.
model BriefingQuestion {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  companyId String               @db.ObjectId
  company   Company              @relation(fields: [companyId], references: [id])
  section   String
  label     String
  type      BriefingQuestionType
  order     Int
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([companyId])
}

// One submitted answer. Deliberately holds only the questionId, not a
// snapshot of its label/type/section — those are resolved live against
// the company's current BriefingQuestion list when displayed, so editing
// a question later relabels old answers too (same as most form builders).
// A question deleted after being answered just won't resolve — its
// answers are orphaned rather than shown, an accepted v1 gap.
type BriefingAnswer {
  questionId String
  // Scalar answer (TEXT/TEXTAREA/NUMBER-as-string/DATE-as-ISO-string).
  value      String?
  // Multi-value answer, only meaningful for LINKS questions.
  values     String[]
}

// The client's own answers about their new project — filled by them
// through the public link (GET/POST .../briefing/public, no auth), read
// by the office in-app (GET .../briefing, authenticated). One per project;
// a re-submission just overwrites the previous answers, so there's no
// history of edits.
model ProjectBriefing {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  projectId String           @unique @db.ObjectId
  project   Project          @relation(fields: [projectId], references: [id])
  answers   BriefingAnswer[]

  // Null until the client actually submits the form once — lets the
  // office tell "not sent yet" apart from "sent but left everything blank".
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Shared reference data: no companyId, managed only by VINCEL_ADMIN via the
// admin dashboard, read by every company's project-creation flow.
model ProjectType {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  // lucide-react icon name (see src/components/ui/icons.ts on the front).
  icon      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Service {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Shared reference data (no companyId): one global product catalog, shared
// by every escritório — including products auto-registered from partner
// search results (Telha Norte, Leroy Merlin, Loja Obra Fácil...). Per-
// project specifics (price paid, quantity, status, notes) live on
// ProjectMaterial instead.
model Product {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  sku         String
  name        String
  description String?
  // Unidade de medida, texto livre (ex: "m²", "un", "kg").
  unit        String
  weight      Float?
  brand       String?
  image       String?
  width       Float?
  height      Float?
  depth       Float?
  colors      String[]
  category    String?
  // Catalog source (e.g. "Telha Norte", "Leroy Merlin") — same sku can
  // legitimately repeat across different suppliers, so uniqueness is the
  // (sku, supplier) pair, not sku alone. Null for a manually-cadastrado
  // product with no known supplier.
  supplier    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  prices           Price[]
  projectMaterials ProjectMaterial[]

  @@unique([sku, supplier])
}

model Supplier {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  prices Price[]
}

// Immutable: a price change always inserts a new record. The current price
// for a product+supplier pair is the one with the latest validFrom.
model Price {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  supplierId String   @db.ObjectId
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  price      Float
  validFrom  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId, supplierId, validFrom])
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String    @unique
  // Absent for accounts created via an OAuth provider (e.g. Google).
  passwordHash String?
  // Set for accounts created/linked via Google OAuth. Not @unique here:
  // MongoDB's unique index isn't sparse for Prisma-written nulls, so two
  // password-based users (both with no googleId) would collide. Uniqueness
  // is enforced at the application layer once the Google OAuth flow exists.
  googleId     String?
  role         UserRole
  active       Boolean   @default(true)
  // Required for every role except VINCEL_ADMIN, enforced at the application layer.
  companyId    String?   @db.ObjectId
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens RefreshToken[]
  timeEntries   TimeEntry[]
}

// Backs the "stay logged in" refresh flow: the access token (JwtStrategy)
// stays short-lived, while this opaque, rotating token lets the front renew
// it silently for as long as RefreshToken.expiresAt allows. Only a SHA-256
// hash of the raw token is ever stored — the raw value exists solely in the
// client and in transit, same principle as passwordHash above.
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  // Null while active. Set either when this token is rotated into a
  // successor (normal use) or when a reuse of an already-rotated token is
  // detected and the whole chain is force-revoked (see AuthService.refreshTokens).
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

// The acquirer actually processing a given Plan/Subscription/PaymentCharge.
// Kept as its own enum (not derived from a config list) so a value already
// persisted on a record stays meaningful even if that acquirer is later
// disabled for new signups.
enum AcquirerType {
  MERCADO_PAGO
}

enum SubscriptionStatus {
  // Checkout created at the acquirer, payer hasn't completed authorization yet.
  PENDING
  // Authorized, current date within the plan's trial window.
  TRIALING
  // Authorized, past trial, in good standing.
  ACTIVE
  // Authorized, but the last charge attempt failed.
  PAST_DUE
  CANCELED
}

enum ChargeStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

// Per-acquirer identifier for a Plan (e.g. Mercado Pago's preapproval_plan
// id). A Plan can be synced to more than one acquirer at once.
type PlanAcquirerRef {
  acquirer       AcquirerType
  externalPlanId String
}

// Shared reference data (no companyId), managed only by VINCEL_ADMIN — the
// catalog of subscription tiers companies choose from.
model Plan {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  // Monthly amount charged after the trial, in BRL.
  price       Float
  trialDays   Int       @default(0)
  active      Boolean   @default(true)
  // At most one plan is default at a time — enforced at the application
  // layer (PlansService), not a DB constraint. New companies are auto-
  // trialed into whichever plan has this set.
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  acquirerRefs  PlanAcquirerRef[]
  subscriptions Subscription[]
}

// One row per company subscription lifecycle. A company that cancels and
// re-subscribes gets a new row rather than reusing the old one, so history
// isn't overwritten — enforced at the application layer, not a DB constraint.
model Subscription {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  companyId String  @db.ObjectId
  company   Company @relation(fields: [companyId], references: [id])
  planId    String  @db.ObjectId
  plan      Plan    @relation(fields: [planId], references: [id])

  // Null while the company is on the free signup trial and hasn't checked
  // out with any acquirer yet — set the moment they start a real checkout.
  acquirer               AcquirerType?
  // Null until the acquirer confirms the checkout (e.g. Mercado Pago's
  // preapproval id) — set from the webhook, not at creation time.
  externalSubscriptionId String?
  status                 SubscriptionStatus @default(PENDING)
  // Where the payer completes authorization; only meaningful while status is PENDING.
  checkoutUrl            String?

  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges PaymentCharge[]

  @@index([companyId])
  @@index([acquirer, externalSubscriptionId])
}

// One row per billing event reported by an acquirer's webhook. The
// (acquirer, externalId) uniqueness is what makes webhook processing
// idempotent under retries.
model PaymentCharge {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String       @db.ObjectId
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  acquirer   AcquirerType
  externalId String
  status     ChargeStatus
  amount     Float
  occurredAt DateTime

  createdAt DateTime @default(now())

  @@unique([acquirer, externalId])
  @@index([subscriptionId])
}

// A standalone reminder on the Agenda calendar — not tied to a project or
// to the project's own Cronograma (see PlanningPhase). Just a name and a
// date the office wants to remember.
model AgendaTask {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  date      DateTime
  companyId String    @db.ObjectId
  company   Company   @relation(fields: [companyId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

// One sidebar-timer session — "Atividade" + "Projeto", started/paused/
// stopped by the logged-in user. endedAt stays null while the timer is
// running (paused or not); pausedAt is set only while actively paused, and
// its elapsed gap folds into pausedMs on resume/stop. Real worked duration
// is always (endedAt - startedAt - pausedMs).
model TimeEntry {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  activity  String
  projectId String    @db.ObjectId
  project   Project   @relation(fields: [projectId], references: [id])
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id])
  companyId String    @db.ObjectId
  company   Company   @relation(fields: [companyId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  pausedMs  Int       @default(0)
  pausedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([userId])
  @@index([projectId])
}
