generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VINCEL_ADMIN
  ADMIN
  ARCHITECT
  FINANCE
  CUSTOMER
}

// A "company" is a tenant (escritório). Every tenant-owned record carries a
// companyId; shared reference data (project types, services, materials...)
// does not and stays global across tenants.
model Company {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  document  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String    @unique
  role      UserRole
  // Required for every role except VINCEL_ADMIN, enforced at the application layer.
  companyId String?   @db.ObjectId
  company   Company?  @relation(fields: [companyId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
